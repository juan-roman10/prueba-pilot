# Nombre de la aplicación / proyecto
COMPOSE_PROJECT_NAME=laravel_app

# Puertos expuestos en el host
NGINX_PORT=8000
MYSQL_PORT=3307
PMA_PORT=8080
REDIS_PORT=6379

# Configuración de Base de Datos (MySQL 5.7)
DB_DATABASE=laravel
DB_USER=laravel_user
DB_PASSWORD=laravel_password
DB_ROOT_PASSWORD=root_password

# Usuario no-root para permisos dentro del contenedor PHP
WWWUSER=1000
WWWGROUP=1000
